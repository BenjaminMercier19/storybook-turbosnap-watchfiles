{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "repro": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": ".storybook",
            "outputDir": "storybook-static",
            "statsJson": true,
            "enableProdMode": false
          }
        }
      }
    }
  },
  "cli": { "analytics": false }
}
